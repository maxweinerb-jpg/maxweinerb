---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Max Weiner — Customer Success, AI, Builder">

  <div class="mw-hero">
    <h1 class="mw-hero-headline">Max Weiner<em>Customer Success Leader <span class="mw-sep">·</span> CS &amp; AI Strategist <span class="mw-sep">·</span> Coach</em></h1>
  </div>

  <div class="mw-banner">
    <div class="mw-banner-rule"></div>
    <div class="mw-banner-eyebrow">Status</div>
    <p class="mw-banner-line">This page is under construction — <em>check back soon.</em></p>
  </div>

</Layout>

<style>
  /* Override Layout's main constraints so sections control their own spacing */
  :global(main) {
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .mw-hero {
    padding: 5.5rem 3rem 3rem;
    max-width: 780px;
  }

.mw-hero-headline {
    font-family: var(--font-ubuntu);
    font-size: 52px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .mw-hero-headline em {
    display: block;
    font-family: var(--font-sans);
    font-size: 22px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-accent);
    margin-top: 1rem;
  }

  .mw-sep {
    font-style: normal;
    margin: 0 0.45rem;
    opacity: 0.4;
  }

  .mw-banner {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 3rem 6rem;
    text-align: center;
  }

  .mw-banner-rule {
    width: 48px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
    margin: 0 auto 1.5rem;
  }

  .mw-banner-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .mw-banner-line {
    font-family: var(--font-ubuntu);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin: 0;
  }

  .mw-banner-line em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }

</style>
